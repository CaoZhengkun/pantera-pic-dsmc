!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
!!!!  Pantera input file                                              !!!!!!!!
!!!!  Case 2 — Turner et al. (2013) CCP He benchmark                   !!!!!!!!
!!!!  Phys. Plasmas 20, 013507                                         !!!!!!!!
!!!!                                                                   !!!!!!!!
!!!!  Geometry:   1D Cartesian, 6.7 cm gap, 13.56 MHz RF               !!!!!!!!
!!!!  Pressure:   n_g = 32.1e20 m^-3 (~100 Torr He at 300 K)          !!!!!!!!
!!!!  Voltage:    V_RF = 200 V (peak), V(0) = 200 V (cos phase)        !!!!!!!!
!!!!  Grid:       Nx = 256, ∆x = λ_D/2.02                             !!!!!!!!
!!!!  Particles:  N_c = 256 mac/cell, Fnum = 1.37e5                   !!!!!!!!
!!!!  Timestep:   ∆t = 1/(800f) = 9.218e-11 s, N_steps = 4,096,000    !!!!!!!!
!!!!                                                                   !!!!!!!!
!!!!  All units are SI [m, kg, s, K, V]                                !!!!!!!!
!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!


! ========= Computational domain and grid ===========

Dimensions:
2
Axisymmetric:
.FALSE.

! 1D in x with 1 cell in y — parallel plates at x = 0 and x = 0.067 m
Domain_limits:
0.0  0.067  0.0  2.6172e-4  -0.5  0.5   ! xmin xmax ymin ymax zmin zmax

Number_of_cells:
256  1  1


! ========= Numerical parameters =====================

Fnum:
1.37e5
Timestep:
9.2181e-11
Number_of_timesteps:
4096000
Stats_every:
5000

! === Collisions — MCC with He background ===========

Collision_type:
MCC

MCC_background_dens:
32.1e20
MCC_background_Ttra:
300.0
MCC_background_mixture:
He 1.0

Reactions_file:
'../helium.react'


! ========= Multi-species ============================

Species_file:
'../helium.species'

Def_mixture:
electrons e- 1.0

Def_mixture:
ions He+ 1.0


! ========= Boundary conditions ======================

! Left electrode (x = 0):   grounded, φ = 0
! Right electrode (x = L):  RF driven, φ = 200·cos(2π·13.56e6·t)

Domain_specular:
.FALSE.  .FALSE.  .FALSE.  .FALSE.

Domain_potential:
0.0  0.0  0.0  0.0
Domain_rf_amplitude:
0.0  400.0  0.0  0.0
Domain_rf_frequency:
13.56e6


! ========= Initial conditions =======================

! Initial uniform plasma: n0 = 5.12e14 m^-3
! Electron temperature: T_e = 30000 K (~2.585 eV)
! Ion temperature:      T_i = 300 K

Initial_particles:
electrons  5.12e14  0.0  0.0  0.0  30000.  30000.  30000.  0.  0.

Initial_particles:
ions       5.12e14  0.0  0.0  0.0    300.    300.    300.  0.  0.


! ========= Output paths =============================

All_output_path:
'./dumps/'

! Grid output averaged over last 32 RF cycles (= 25600 steps)
Dump_grid_start:
4070400
Dump_grid_avgevery:
1
Dump_grid_numavgs:
25600

Dump_bound_start:
4070400
Dump_bound_avgevery:
1
Dump_bound_numavgs:
25600

Dump_part_start:
1000000

Perform_checks:
.FALSE.

! ========= End of input file ========================
