!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
!!!!  Pantera input file                                              !!!!!!!!
!!!!  Case 4 — Turner et al. (2013) CCP He benchmark                   !!!!!!!!
!!!!  Phys. Plasmas 20, 013507                                         !!!!!!!!
!!!!                                                                   !!!!!!!!
!!!!  Geometry:   1D Cartesian, 6.7 cm gap, 13.56 MHz RF               !!!!!!!!
!!!!  Pressure:   n_g = 321e20 m^-3 (~1000 Torr He at 300 K)          !!!!!!!!
!!!!  Voltage:    V_RF = 120 V (peak), V(0) = 120 V (cos phase)        !!!!!!!!
!!!!  Grid:       Nx = 512, ∆x = λ_D/4.66                              !!!!!!!!
!!!!  Particles:  N_c = 64 mac/cell, Fnum = 1.03e5                    !!!!!!!!
!!!!  Timestep:   ∆t = 1/(3200f) = 2.304e-11 s, N_steps = 49,152,000  !!!!!!!!
!!!!                                                                   !!!!!!!!
!!!!  All units are SI [m, kg, s, K, V]                                !!!!!!!!
!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!


! ========= Computational domain and grid ===========

Dimensions:
2
Axisymmetric:
.FALSE.

! 1D in x with 1 cell in y — parallel plates at x = 0 and x = 0.067 m
Domain_limits:
0.0  0.067  0.0  1.3086e-4  -0.5  0.5   ! xmin xmax ymin ymax zmin zmax

Number_of_cells:
512  1  1


! ========= Numerical parameters =====================

Fnum:
1.03e5
Timestep:
2.3045e-11
Number_of_timesteps:
49152000
Stats_every:
50000

! === Collisions — MCC with He background ===========

Collision_type:
MCC

MCC_background_dens:
321e20
MCC_background_Ttra:
300.0
MCC_background_mixture:
He 1.0

Reactions_file:
'../helium.react'


! ========= Multi-species ============================

Species_file:
'../helium.species'

Def_mixture:
electrons e- 1.0

Def_mixture:
ions He+ 1.0


! ========= Boundary conditions ======================

! Left electrode (x = 0):   grounded, φ = 0
! Right electrode (x = L):  RF driven, φ = 120·cos(2π·13.56e6·t)

Domain_specular:
.FALSE.  .FALSE.  .FALSE.  .FALSE.

Domain_potential:
0.0  0.0  0.0  0.0
Domain_rf_amplitude:
0.0  240.0  0.0  0.0
Domain_rf_frequency:
13.56e6


! ========= Initial conditions =======================

! Initial uniform plasma: n0 = 3.84e14 m^-3
! Electron temperature: T_e = 30000 K (~2.585 eV)
! Ion temperature:      T_i = 300 K

Initial_particles:
electrons  3.84e14  0.0  0.0  0.0  30000.  30000.  30000.  0.  0.

Initial_particles:
ions       3.84e14  0.0  0.0  0.0    300.    300.    300.  0.  0.


! ========= Output paths =============================

All_output_path:
'./dumps/'

! Grid output averaged over last 32 RF cycles (= 102400 steps)
Dump_grid_start:
49049600
Dump_grid_avgevery:
1
Dump_grid_numavgs:
102400

Dump_bound_start:
49049600
Dump_bound_avgevery:
1
Dump_bound_numavgs:
102400

Dump_part_start:
1000000

Perform_checks:
.FALSE.

! ========= End of input file ========================
