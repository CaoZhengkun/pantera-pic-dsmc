! Turner et al. (2013) CCP benchmark, case 4.
! Full base calculation: 15360 RF periods, averaged over the final 32 periods.

Dimensions:
1
Axisymmetric:
.FALSE.
Domain_limits:
0.0 0.067 0.0 1.0 0.0 1.0
Number_of_cells:
512 1 1

! MPI runs in the current src require the unstructured-grid partition path.
Mesh_file:
'case4.msh'

Partition_style:
stripsx

Domain_periodicity:
.FALSE. .TRUE. .TRUE.
Domain_specular:
.FALSE. .FALSE. .FALSE. .FALSE.
Domain_diffuse:
.FALSE. .FALSE. .FALSE. .FALSE.

PIC_type:
explicit

! Turner specifies 120 V peak. PANTERA expects peak-to-peak amplitude here.
Domain_potential:
0.0 0.0 0.0 0.0
Domain_rf_amplitude:
0.0 240.0 0.0 0.0
Domain_rf_frequency:
1.356e7

Domain_type:
cell fluid 1.0

Boundary_condition:
left dirichlet 0.0
Boundary_condition:
right rf_voltage 240.0 0.0 1.356e7
Boundary_condition:
left vacuum
Boundary_condition:
right vacuum

Fnum:
7.8515625e8
Timestep:
2.3045722714e-11
Number_of_timesteps:
49152000
Stats_every:
3200
Timing_stats_every:
32000
RNG_seed:
12345
Save_initial_timestep:
.FALSE.
Binary_output:
.FALSE.

Species_file:
'../helium.species'
Def_mixture:
electrons e- 1.0
Def_mixture:
ions He+ 1.0
Def_mixture:
Neutrals He 1.0

Collision_type:
MCC_VAHEDI
MCC_background_mixture:
Neutrals
MCC_background_dens:
3.21e22
MCC_background_Ttra:
300.0
! PANTERA multiplies this rate coefficient [m3/s] by the gas density.
MCC_null_rate:
2.0e-13
CS_table_oob:
clamp
Reactions_file:
'../helium.react'
Remove_particles_in_mixture:
Neutrals

All_output_path:
'./dumps/'
! At dt=1/(3200f), each 32/f average contains 102400 time steps.
! The final file at step 49152000 is the paper's final averaging window.
Dump_grid_start:
0
Dump_grid_avgevery:
1
Dump_grid_numavgs:
102400

! Boundary VTK dumping is not required for the Turner CCP1D diagnostics.
Dump_bound_start:
100000000
Dump_bound_avgevery:
3200
Dump_bound_numavgs:
1
Dump_part_start:
100000000
Dump_part_every:
100000000

! Runtime CCP1D diagnostics use their own averaging/output cadence.
CCP1D:
.TRUE. 102400

Perform_checks:
.TRUE.
Checks_every:
102400

Initial_particles:
electrons 3.84e14 0.0 0.0 0.0 30000.0 30000.0 30000.0 0.0 0.0
Initial_particles:
ions 3.84e14 0.0 0.0 0.0 300.0 300.0 300.0 0.0 0.0
