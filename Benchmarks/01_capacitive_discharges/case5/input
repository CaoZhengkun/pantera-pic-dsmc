!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
!!!!  Pantera input file                                              !!!!!!!!
!!!!  Case 1 — Turner et al. (2013) CCP He benchmark                   !!!!!!!!
!!!!  Phys. Plasmas 20, 013507                                         !!!!!!!!
!!!!                                                                   !!!!!!!!
!!!!  Geometry:   1D Cartesian, 6.7 cm gap, 13.56 MHz RF               !!!!!!!!
!!!!  Pressure:   n_g = 9.64e20 m^-3 (~30 Torr He at 300 K)           !!!!!!!!
!!!!  Voltage:    V_RF = 450 V (peak), V(0)=0 (cos phase)              !!!!!!!!
!!!!  Grid:       Nx = 128, ∆x = λ_D/1.43                             !!!!!!!!
!!!!  Particles:  N_c = 512 mac/cell, Fnum = 1.37e5                   !!!!!!!!
!!!!  Timestep:   ∆t = 1/(400f) = 1.844e-10 s, N_steps = 512,000      !!!!!!!!
!!!!                                                                   !!!!!!!!
!!!!  All units are SI [m, kg, s, K, V]                                !!!!!!!!
!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!


! ========= Computational domain and grid ===========

Dimensions:
1
Axisymmetric:
.FALSE.

! 1D in x with 1 cell in y — parallel plates at x = 0 and x = 0.067 m
Domain_limits:
0.0  0.067  0.0  5.2344e-4  -0.5  0.5   ! xmin xmax ymin ymax zmin zmax

Number_of_cells:
128  1  1

Mesh_file:
'case1.msh'


! ========= Numerical parameters =====================

Fnum:
1.37e5
Timestep:
1.8436e-10
Number_of_timesteps:
512000
PIC_type:
explicit

Stats_every:
1000

! === Collisions — MCC with He background ===========

Collision_type:
MCC_VAHEDI

MCC_background_dens:
9.64e20
MCC_background_Ttra:
300.0
MCC_background_mixture:
background
MCC_null_rate:
1e-10

Reactions_file:
'../helium.react'

CS_table_oob:
clamp

! ========= Multi-species ============================

Species_file:
'../helium.species'

Def_mixture:
electrons e- 1.0

Def_mixture:
ions He+ 1.0
Def_mixture:
background He 1.0

Remove_mixture:
background


! ========= Boundary conditions ======================

! Left electrode (x = 0):   grounded, φ = 0 (DC + RF = 0)
! Right electrode (x = L):  RF driven, φ = 0 + 450·sin(2π·13.56e6·t)

! Potential BCs via physical groups in the mesh file
Boundary_condition:
left dirichlet 0.0

Boundary_condition:
right rf_voltage 900.0 0.0 13.56e6


! ========= Initial conditions =======================

! Initial uniform plasma: n0 = 2.56e14 m^-3
! Electron temperature: T_e = 30000 K (~2.585 eV)
! Ion temperature:      T_i = 300 K
! Zero drift velocity

Initial_particles:
electrons  2.56e14  0.0  0.0  0.0  30000.  30000.  30000.  0.  0.

Initial_particles:
ions       2.56e14  0.0  0.0  0.0    300.    300.    300.  0.  0.


! ========= Output paths =============================

All_output_path:
'./dumps/'

! Grid output averaged over last 32 RF cycles (= 12800 steps)
Dump_grid_start:
499200
Dump_grid_avgevery:
1
Dump_grid_numavgs:
12800

Dump_bound_start:
499200
Dump_bound_avgevery:
1
Dump_bound_numavgs:
12800

Dump_part_start:
1000000

Perform_checks:
.FALSE.

! ========= End of input file ========================
